# Personal OS — environment variables. NO REAL SECRETS IN THIS FILE.
# Copy to .env.local for local dev. Production/preview values live in Vercel (separate per environment).
# Validated at boot by src/lib/env.ts (Zod). Only NEXT_PUBLIC_* reach the browser.

# ---- App (Phase 1) -----------------------------------------------------------
APP_ENV=local                         # local | preview | production
APP_URL=http://localhost:3000
LOG_LEVEL=info                        # debug | info | warn | error
OWNER_EMAIL=founder@example.com       # the only account allowed to sign in

# ---- Supabase (Phase 1) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me   # RLS-restricted, safe for browser
SUPABASE_SECRET_KEY=sb_secret_replace_me                         # SERVER ONLY. Bypasses RLS.

# ---- API keys (Phase 1) ------------------------------------------------------
API_KEY_PREFIX_ENV=test               # live in production -> keys look like pk_live_...

# ---- Observability (Phase 1, optional locally) -------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Integration token encryption (Phase 2) ----------------------------------
# Generate: openssl rand -base64 32   (different key per environment)
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
TOKEN_ENCRYPTION_KEY_PREVIOUS=        # only during key rotation

# ---- Google: Calendar (Phase 2), Gmail (Phase 4) -----------------------------
# ADR-013: personal @gmail.com -> OAuth consent screen "External", publishing status "Testing",
# Founder added as the only test user. Refresh tokens expire 7 days after consent (weekly reconnect).
# Use a separate Google Cloud project / OAuth client per environment (local+preview vs production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_WEBHOOK_TOKEN=                 # Phase 8: Calendar push channel token

# ---- Resend (Phase 4) --------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ---- Notion (Phase 5) — only if OAuth is chosen; default is an internal token entered in Settings (ADR-013)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ---- GitHub (Phase 5 / 8) ----------------------------------------------------
GITHUB_TOKEN_MODE=pat                 # pat (token stored encrypted via UI) | app
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---- AI / MCP -----------------------------------------------------------------
# Phase 1.5a (Cursor) needs NO server env vars: Cursor sends a Personal OS API key (pk_live_..., created in
# Settings -> API keys) from ~/.cursor/mcp.json via ${env:PERSONAL_OS_MCP_KEY} in YOUR shell. Never put it here.
# Phase 1.5b (ChatGPT): MCP_OAUTH_ISSUER below + Supabase Auth -> OAuth Server enabled (DCR on,
# authorization path /oauth/consent). No OAuth client secrets are stored by this app.
# Phase 7: Command Center LLM.
AI_PROVIDER=                          # openai | anthropic | ... (provider-agnostic adapter)
AI_API_KEY=
AI_MODEL=
MCP_OAUTH_ISSUER=                     # P1.5b: http://127.0.0.1:54321/auth/v1 locally; empty = MCP OAuth off (API keys only)

# ---- Automation (Phase 8) ----------------------------------------------------
CRON_SECRET=
